@article{BREITENBACH1999135,
title = {Against spectral leakage},
journal = {Measurement},
volume = {25},
number = {2},
pages = {135-142},
year = {1999},
issn = {0263-2241},
doi = {https://doi.org/10.1016/S0263-2241(98)00074-8},
url = {https://www.sciencedirect.com/science/article/pii/S0263224198000748},
author = {Arvid Breitenbach},
keywords = {Coherence, Spectral leakage, DFT, FFT, Windowing, Spectrum analysis, Repetitive sampling, Hybrid spectrum computation},
abstract = {Analysis of periodic signals is often performed in the frequency domain. The evaluation of time-discrete spectra, however, is hampered by leakage, which occurs if a non-integral number of periods is present in the sampled data set. Minimization of spectral leakage is an important prerequisite for spectrum analysis. The use of non-rectangular time-domain windowing functions offers some improvement but also invites unwanted side-effects. Spectral leakage can be avoided entirely by ensuring that an integer number of periods falls into the sampling time (e.g. by the use of coherent sampling). Some aspects of coherent sampling are treated, including repetitive sampling, which can be both an advantage and a disadvantage, depending on what sort of information is required. Two methods for `emulating' coherent sampling when only an incoherently recorded data set is available are also described. One of them, hybrid spectrum computation, can practically confine spectral leakage to two spectral values.}
}

